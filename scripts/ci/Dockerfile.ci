# Portable CI image: pinned Go, Task, revive, staticcheck. No GitHub Actions.
# Run: bash scripts/ci/run-docker.sh pr

FROM ubuntu:24.04

RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		bash ca-certificates curl git xz-utils python3 python3-venv \
	&& rm -rf /var/lib/apt/lists/*

ENV CI_TOOLCHAIN_ROOT=/opt/ci-toolchain
ENV PATH=/opt/ci-toolchain/bin:/opt/ci-toolchain/go/bin:${PATH}
ENV GOPATH=/opt/ci-toolchain/gopath
ENV GOCACHE=/opt/ci-toolchain/gocache
ENV GOTOOLCHAIN=local
ENV CGO_ENABLED=0

WORKDIR /src
COPY scripts/ci/versions.env scripts/ci/versions.env
COPY scripts/ci/dev-tools.env scripts/ci/dev-tools.env
COPY scripts/ci/env.sh scripts/ci/env.sh
COPY scripts/ci/bootstrap-toolchain.sh scripts/ci/bootstrap-toolchain.sh
COPY scripts/ci/bootstrap.sh scripts/ci/bootstrap.sh

RUN CI_BOOTSTRAP=install CI_TOOLCHAIN_ROOT=/opt/ci-toolchain \
	GOFLAGS= GOPROXY=https://proxy.golang.org,direct GOSUMDB=sum.golang.org \
	bash scripts/ci/bootstrap-toolchain.sh install

COPY . .

CMD ["bash", "scripts/ci/run.sh", "pr"]
