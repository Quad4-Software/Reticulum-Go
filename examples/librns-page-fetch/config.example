# Sample config for librns examples.
# share_instance must be off for an in-process librns host.
#
# Pick an online TCP or Backbone hub from:
#   https://directory.rns.recipes/api/directory/submitted?status=online
# Paste one [[Interface]] block under [interfaces] below.
# Local AutoInterface is optional for LAN peers.

[reticulum]
enable_transport = yes
share_instance = no
in_memory_storage = yes
enable_sandbox = no

[logging]
loglevel = 3

[interfaces]

  [[Auto Discovery]]
    type = AutoInterface
    enabled = yes
